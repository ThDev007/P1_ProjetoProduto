<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1150.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.produtos.ProdutoController">
   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="285.0" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="5.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Dados do produto" />
                  <Label text="Código (8 caracteres alfanuméricos)" />
                  <TextField fx:id="txtCodigo" promptText="Ex.: ARZ00001" />
                  <Label text="Nome" />
                  <TextField fx:id="txtNome" promptText="Ex.: Arroz 5kg" />
                  <Label text="Categoria" />
                  <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Selecione" />
                  <Label text="Preço de compra (R$)" />
                  <TextField fx:id="txtPrecoCompra" promptText="Ex.: 12,00" />
                  <Label text="Preço de venda (R$)" />
                  <TextField fx:id="txtPrecoVenda" promptText="Ex.: 19,90" />
                  <Label text="Quantidade em estoque" />
                  <TextField fx:id="txtQuantidade" promptText="Ex.: 10" />
                  <Label text="Data de fabricação" />
                  <DatePicker fx:id="dpFabricacao" maxWidth="1.7976931348623157E308" />
                  <Label text="Data de validade" />
                  <DatePicker fx:id="dpValidade" maxWidth="1.7976931348623157E308" />
                  <HBox spacing="8.0">
                     <children>
                        <Button fx:id="btnSalvar" defaultButton="true" mnemonicParsing="false" onAction="#salvar" text="Cadastrar" />
                        <Button mnemonicParsing="false" onAction="#novo" text="Novo" />
                        <Button fx:id="btnExcluir" disable="true" mnemonicParsing="false" onAction="#excluir" text="Excluir" />
                     </children>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="10.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Buscar:" />
                  <TextField fx:id="txtBusca" promptText="Código, nome ou categoria" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#exportar" text="Salvar em arquivo..." />
               </children>
            </HBox>
            <TableView fx:id="tabela" prefHeight="300.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodigo" prefWidth="85.0" text="Código" />
                  <TableColumn fx:id="colNome" prefWidth="160.0" text="Nome" />
                  <TableColumn fx:id="colCategoria" prefWidth="100.0" text="Categoria" />
                  <TableColumn fx:id="colPrecoCompra" prefWidth="85.0" text="Compra" />
                  <TableColumn fx:id="colPrecoVenda" prefWidth="85.0" text="Venda" />
                  <TableColumn fx:id="colQuantidade" prefWidth="55.0" text="Qtd." />
                  <TableColumn fx:id="colFabricacao" prefWidth="90.0" text="Fabricação" />
                  <TableColumn fx:id="colValidade" prefWidth="90.0" text="Validade" />
               </columns>
            </TableView>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Relatórios" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <ComboBox fx:id="cmbRelatorio" prefWidth="360.0" />
                  <Button mnemonicParsing="false" onAction="#gerarRelatorio" text="Gerar relatório" />
               </children>
            </HBox>
            <TextArea fx:id="txtRelatorio" editable="false" prefHeight="190.0" style="-fx-font-family: 'Consolas', 'Monospaced';" />
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox style="-fx-background-color: #eeeeee;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
         </padding>
         <children>
            <Label fx:id="lblStatus" text="Pronto." />
         </children>
      </HBox>
   </bottom>
</BorderPane>
